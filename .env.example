# Copy this file to .env.local (development) and/or .env.production (build) and fill in the values.
# .env.local and .env.*.local are git-ignored. Every VITE_ variable ends up in the public JavaScript
# bundle, so only put public values here. Never add the EmailJS private key or any password.

# Production website address, without a trailing slash (e.g. https://www.vvsfincorp.com).
# Used for canonical URLs, Open Graph images, JSON-LD structured data and sitemap.xml.
VITE_SITE_URL=

# Set to false for staging/preview builds so search engines do not index them.
VITE_ALLOW_INDEXING=false

# EmailJS (https://dashboard.emailjs.com) - enquiry form delivery.
# Public key: Account > General > Public Key. Service ID: Email Services. Template ID: Email Templates.
# While any of these is empty, the form falls back to opening the visitor's email app.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
