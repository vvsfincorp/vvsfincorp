# Production build settings (`npm run build`). No secrets here: this file is committed so
# hosting platforms that build from git get the same values. EmailJS keys stay in .env.

# Live domain, no trailing slash. Used for canonical URLs, Open Graph images, JSON-LD and sitemap.xml.
VITE_SITE_URL=https://www.vvsfincorp.com

# Set to false for staging/preview deployments so search engines don't index them.
VITE_ALLOW_INDEXING=true
